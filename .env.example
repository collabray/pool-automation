# Copy to .env and fill in, or generate everything automatically:  node scripts/gen-env.ts --domain pool.example.com --email you@example.com
# NEVER commit .env. Back it up separately and OFFLINE: without these keys, encrypted secrets and backups cannot be read.

# ---- core ----
# Where the SQLite database lives (Docker sets /data/pooltable.db for you).
DB_PATH=./data/pooltable.db
# 32 random bytes, base64. Encrypts device secrets, Daraja credentials and notification keys inside the database, and signs sessions and table codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   LOSING IT MAKES THOSE SECRETS UNRECOVERABLE.
APP_MASTER_KEY=
# Random string (any length >= 16). Used to hash phone numbers for lookups/rate limits so raw numbers are never indexed. Changing it breaks "erase this customer" lookups for old records.
PHONE_HASH_PEPPER=

# ---- network ----
# Port and interface the app listens on. Behind Caddy/Cloudflare keep HOST=127.0.0.1 (or the Docker default).
PORT=8080
HOST=127.0.0.1
# 1 when running behind a reverse proxy (Caddy, Cloudflare Tunnel, nginx) so the real client IP is used for rate limits. 0 when exposed directly.
TRUST_PROXY=0
# 1 to send Strict-Transport-Security. Only enable once HTTPS works.
HSTS=0
# Extra browser origins allowed to call the API (comma separated, https://...). Empty = same origin only. Normally empty.
CORS_ORIGINS=
# 1 to print one log line per request (useful while commissioning).
LOG_REQUESTS=0

# ---- HTTPS (docker compose / Caddy) ----
# Your domain name, and an email for certificate expiry notices.
DOMAIN=pool.example.com
ACME_EMAIL=you@example.com

# ---- backups ----
# 32 random bytes, base64, DIFFERENT from APP_MASTER_KEY. Encrypts backup files. Store a copy off the machine.
BACKUP_KEY=
BACKUP_DIR=./backups
# How many days of daily backups to keep.
BACKUP_KEEP_DAYS=14
